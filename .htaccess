
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{QUERY_STRING} ^slug=byd-dolphin$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-dolphin/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-m6$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-m6/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-atto-2$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-atto-2/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-seal-5$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-seal-5/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-sealion-6$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-sealion-6/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-m9$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-m9/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-atto-3$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-atto-3/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-seal$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-seal/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-han$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-han/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-sealion-8$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-sealion-8/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=khai-truong-showroom-4s$ [NC]
RewriteRule ^tin-tuc/?$ /tin-tuc/khai-truong-showroom-4s/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=ban-giao-xe-byd-atto-2$ [NC]
RewriteRule ^tin-tuc/?$ /tin-tuc/ban-giao-xe-byd-atto-2/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=trai-nghiem-thuc-te-byd$ [NC]
RewriteRule ^tin-tuc/?$ /tin-tuc/trai-nghiem-thuc-te-byd/? [R=301,L,NE]
RewriteCond %{QUERY_STRING} ^slug=byd-sealion-5$ [NC]
RewriteRule ^san-pham/?$ /san-pham/byd-sealion-5/? [R=301,L,NE]
RewriteRule ^tin-tuc/byd-sealion-5-dm-i-lua-chon-suv-gia-dinh-cho-hanh-trinh-dai/?$ /tin-tuc/byd-sealion-6-dm-i-vi-sao-phu-hop-nguoi-thuong-xuyen-di-tinh/ [R=301,L]
</IfModule>
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:css|js|png|jpg|jpeg|gif|svg|webp|ico|woff2|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
